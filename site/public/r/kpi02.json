      "content": "import { Card } from \"@/components/jk/card\"\n\nexport const Kpi02 = () => {\n    return (\n        <div className=\"max-w-7xl px-4 mx-auto my-4\">\n            <div className=\"grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4\">\n                <Card className=\"flex flex-col\">\n                    <div className=\"flex items-center justify-between\">\n                        <span className=\"text-sm font-medium text-fg-muted\">Monthly Recurring Revenue</span>\n                        <span className=\"iconify ph--currency-circle-dollar size-5 text-primary\"></span>\n                    </div>\n                    <span className=\"text-3xl font-semibold text-fg mt-3\">$48.5K</span>\n                    <span className=\"w-max ui-soft ui-soft-success mt-4 inline-flex items-center gap-x-1.5 rounded-md px-2 py-1.5 text-xs font-medium\">\n                        <span aria-hidden=\"true\" className=\"iconify size-4 ph--trend-up\"></span>\n                        +12.5% MoM\n                    </span>\n                </Card>\n\n                <Card className=\"flex flex-col\">\n                    <div className=\"flex items-center justify-between\">\n                        <span className=\"text-sm font-medium text-fg-muted\">Active Subscriptions</span>\n                        <span className=\"iconify ph--users-three size-5 text-primary\"></span>\n                    </div>\n                    <span className=\"text-3xl font-semibold text-fg mt-3\">1,247</span>\n                    <span className=\"w-max ui-soft ui-soft-success mt-4 inline-flex items-center gap-x-1.5 rounded-md px-2 py-1.5 text-xs font-medium\">\n                        <span aria-hidden=\"true\" className=\"iconify size-4 ph--trend-up\"></span>\n                        +28 this month\n                    </span>\n                </Card>\n\n                <Card className=\"flex flex-col\">\n                    <div className=\"flex items-center justify-between\">\n  