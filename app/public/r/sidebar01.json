{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar01",
  "title": "Sidebar 01",
  "description": "Collapsible sidebar navigation with icons",
  "files": [
    {
      "path": "src/blocks/application/sidebar/01/sidebar01.tsx",
      "content": "import { SidebarProvider, SidebarToggler } from '@/components/jk/sidebar'\nimport type { ReactNode } from 'react'\nimport { Sidebar } from './sidebar'\nimport { Button } from '@/components/jk/button'\n\n\nexport const Sidebar01 = () => {\n  return (\n    <SidebarProvider>\n      <Sidebar />\n      <MainContent>\n        <main>\n\n        </main>\n      </MainContent>\n    </SidebarProvider>\n  )\n}\nconst MainContent = ({ children }: { children: ReactNode }) => {\n\n  return <div className=\"md:pl-64\">\n    <header className=\"w-full flex h-16 bg-background sticky top-0 z-35\">\n      <div className=\"flex items-center justify-between w-full h-full px-4 sm:px-8\">\n        <div className=\"flex items-center gap-3\">\n          <div\n            className=\"flex md:hidden pr-2 relative before:absolute before:inset-y-2 before:right-0 before:w-0.5 before:bg-border\">\n            <SidebarToggler aria-label='Open sidebar'>\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"\n                className=\"size-4\">\n                <rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" />\n                <path d=\"M9 3v18\" /><path d=\"m14 9 3 3-3 3\" />\n              </svg>\n            </SidebarToggler>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-0.5\">\n          <Button variant=\"ghost\" size=\"sm\" iconOnly>\n            <span className=\"iconify ph--gear size-4.5\"></span>\n          </Button>\n          <div className=\"relative\">\n            <Button variant=\"ghost\" size=\"sm\" iconOnly>\n              <span className=\"iconify ph--bell size-4.5\"></span>\n            </Button>\n            <span className=\"absolute top-1.5 right-2 w-2 h-2 bg-destructive rounded-full border-2 border-bg\"></span>\n          </div>\n        </div>\n      </div>\n    </header>\n\n\n    {children}\n  </div>\n\n}\n\n",
      "type": "registry:block",
      "target": "page.tsx"
    },
    {
      "path": "src/blocks/application/sidebar/01/sidebar.tsx",
      "content": "import { SidebarBase, SidebarOverlayElement } from '@/components/jk/sidebar'\nimport { SidebarItem } from './sidebar-item';\nimport { Button } from '@/components/jk/button';\nimport { Avatar } from '@/components/jk/avatar';\nimport {\n    Menu,\n    MenuContent,\n    MenuHeader,\n    MenuIcon,\n    MenuItem,\n    MenuLabel,\n    MenuSection,\n    MenuSeparator,\n    MenuSubMenu\n} from \"@/components/jk/menu\"\n\n\nconst items = [\n    {\n        id: '01',\n        href: '#',\n        text: 'Notes',\n        icon: 'ph--note',\n        isActive: true,\n    },\n    {\n        id: '02',\n        href: '#',\n        text: 'Calendar',\n        icon: 'ph--calendar',\n    },\n    {\n        id: '03',\n        href: '#',\n        text: 'Tasks',\n        icon: 'ph--kanban',\n    },\n];\nexport const Sidebar = () => {\n    return (\n        <>\n            <SidebarOverlayElement className=\"md:hidden md:invisible invisible opacity-0 fx-open:visible fx-open:opacity-100 ease-linear transition-all duration-200 z-50\" />\n\n            <SidebarBase className=\"fixed h-dvh py-3 overflow-hidden w-11/12 max-w-64 md:w-64 transition-all -translate-x-full fx-open:translate-x-0 md:translate-x-0 md:transition-none  bg-card border-r border-bg-muted/70 flex flex-col justify-between px-4 ease-linear z-80\">\n                <div className=\"min-h-max py-2 border-b border-border\">\n                    <a href=\"#\" className=\"flex items-center gap-x-3 font-semibold text-foreground-subtitle\">\n                        <span className=\"size-8 bg-fg-title text-background rounded-lg d-flex-place-center shadow-sm transition-colors duration-300\">\n                            <svg aria-hidden=\"true\" width=\"488\" height=\"488\" className=\"size-5\" viewBox=\"0 0 488 488\" fill=\"none\"\n                                xmlns=\"http://www.w3.org/2000/svg\">\n                                <g clipPath=\"url(#clip0_13_164)\">\n                                    <path\n                                        d=\"M71.5342 71L416.602 416.068V416.068C321.314 511.356 166.822 511.356 71.5342 416.068V416.068C-23.7537 320.78 -23.7537 166.288 71.5342 71V71Z\"\n                                        fill=\"currentColor\" ></path>\n                                    <path\n                                        d=\"M483.659 249.5C483.659 274.629 436.788 344.5 411.659 344.5C386.53 344.5 392.659 274.629 392.659 249.5C392.659 224.371 413.03 204 438.159 204C463.288 204 483.659 224.371 483.659 249.5Z\"\n                                        fill=\"currentColor\" ></path>\n                                    <circle cx=\"243.429\" cy=\"243.759\" r=\"110\" transform=\"rotate(48.3973 243.429 243.759)\"\n                                        fill=\"currentColor\" stroke=\"white\" strokeWidth=\"80\" className=\"stroke-fg-title\"></circle>\n                                    <path\n                                        d=\"M309 71C309 96.129 212.629 101 187.5 101C162.371 101 142 80.629 142 55.5C142 30.371 162.371 10 187.5 10C212.629 10 309 45.871 309 71Z\"\n                                        fill=\"currentColor\" ></path>\n                                    <path\n                                        d=\"M417 101.5C417 126.629 415.129 215.5 390 215.5C364.871 215.5 326 126.629 326 101.5C326 76.371 346.371 56 371.5 56C396.629 56 417 76.371 417 101.5Z\"\n                                        fill=\"currentColor\" ></path>\n                                </g>\n                                <defs>\n                                    <clipPath id=\"clip0_13_164\">\n                                        <rect width=\"488\" height=\"488\" fill=\"currentColor\" className=\"text-background\"></rect>\n                                    </clipPath>\n                                </defs>\n                            </svg>\n                        </span>\n                        UnoPlanner\n                    </a>\n                </div>\n\n                <nav className=\"flex-1 pt-6 flex flex-col\">\n                    <span className=\"mb-2 text-sm text-muted-foreground uppercase\">Navigation</span>\n                    <ul className=\"text-muted-foreground space-y-2 w-full\">\n                        {\n                            items.map(item => <SidebarItem key={`sidebar-item-${item.id}`} {...item} />)\n                        }\n                    </ul>\n                </nav>\n                <div>\n                    <ul className=\"flex flex-col gap-y-2 text-muted-foreground\">\n                        <SidebarItem text=\"Settings\" href=\"#\" icon=\"ph--gear\" />\n                        <li className=\"w-full\">\n                            <Menu>\n                                <Button aria-label=\"Open user menu\" size='none' variant='ghost' className=\"gap-3 w-full p-1.5 border border-border/40\">\n                                    <Avatar size=\"md\" radius=\"default\" src={\"https://avatars.githubusercontent.com/u/59884686?v=4\"} width={100} height={100} alt='Johnkat Profile Picture' />\n                                    <div className=\"flex flex-1 justify-between items-center overflow-hidden\">\n                                        <div className=\"flex flex-col -space-y-0.5 text-left flex-1 overflow-hidden\">\n                                            <span className=\"font-semibold text-sm text-foreground truncate\">\n                                                Johnkat MJ\n                                            </span>\n                                            <span className=\"text-xs text-muted-foreground truncate\">\n                                                johnkatmj@gmail.com\n                                            </span>\n                                        </div>\n                                        <span aria-hidden=\"true\" className=\"flex min-w-max text-muted-foreground opacity-60\">\n                                            <span className=\"iconify ph--caret-up-down\"></span>\n                                        </span>\n                                    </div>\n                                </Button>\n                                <MenuContent popover={{ placement: \"top left\" }} className=\"min-w-54\">\n                                    <MenuHeader separator>\n                                        <span className=\"block\">johnkatmj@gmail.com</span>\n                                        <span className=\"font-normal text-muted-foreground\">@katmj</span>\n                                    </MenuHeader>\n\n                                    <MenuSection>\n                                        <MenuItem href=\"#dashboard\">\n                                            <MenuIcon aria-hidden=\"true\">\n                                                <span className=\"iconify ph--squares-four\" />\n                                            </MenuIcon>\n                                            <MenuLabel>Dashboard</MenuLabel>\n                                        </MenuItem>\n                                        <MenuItem href=\"#settings\">\n                                            <MenuIcon aria-hidden=\"true\">\n                                                <span className=\"iconify ph--gear-six\" />\n                                            </MenuIcon>\n                                            <MenuLabel>Settings</MenuLabel>\n                                        </MenuItem>\n                                    </MenuSection>\n\n                                    <MenuSeparator />\n\n                                    <MenuItem>\n                                        <MenuIcon aria-hidden=\"true\">\n                                            <span className=\"iconify ph--terminal-window\" />\n                                        </MenuIcon>\n                                        <MenuLabel>Command Menu</MenuLabel>\n                                    </MenuItem>\n\n                                    <MenuSubMenu>\n                                        <MenuItem>\n                                            <MenuIcon aria-hidden=\"true\">\n                                                <span className=\"iconify ph--sun-horizon\" />\n                                            </MenuIcon>\n                                            <MenuLabel>Switch theme</MenuLabel>\n                                        </MenuItem>\n                                        <MenuContent>\n                                            <MenuItem>\n                                                <MenuIcon aria-hidden=\"true\">\n                                                    <span className=\"iconify ph--monitor\" />\n                                                </MenuIcon>\n                                                <MenuLabel>System</MenuLabel>\n                                            </MenuItem>\n                                            <MenuItem>\n                                                <MenuIcon aria-hidden=\"true\">\n                                                    <span className=\"iconify ph--moon-stars\" />\n                                                </MenuIcon>\n                                                <MenuLabel>Dark</MenuLabel>\n                                            </MenuItem>\n                                            <MenuItem>\n                                                <MenuIcon aria-hidden=\"true\">\n                                                    <span className=\"iconify ph--sun-dim\" />\n                                                </MenuIcon>\n                                                <MenuLabel>Light</MenuLabel>\n                                            </MenuItem>\n                                        </MenuContent>\n                                    </MenuSubMenu>\n\n                                    <MenuSeparator />\n\n                                    <MenuItem href=\"#contact-s\">\n                                        <MenuLabel>Contact Support</MenuLabel>\n                                    </MenuItem>\n\n                                    <MenuSeparator />\n\n                                    <MenuItem intent=\"destructive\" href=\"#logout\">\n                                        <MenuIcon aria-hidden=\"true\" className='text-current'>\n                                            <span className=\"iconify ph--sign-out text-current\" />\n                                        </MenuIcon>\n                                        <MenuLabel>Log out</MenuLabel>\n                                    </MenuItem>\n                                </MenuContent>\n                            </Menu>\n                        </li>\n                    </ul>\n                </div>\n            </SidebarBase>\n        </>\n    )\n}\n",
      "type": "registry:block",
      "target": "components/sidebar.tsx"
    },
    {
      "path": "src/blocks/application/sidebar/01/sidebar-item.tsx",
      "content": "\nexport const SidebarItem = ({ text, icon, href, isActive }: { text: string, icon: string, href: string, isActive?: boolean }) => {\n    return (\n        <li\n            className=\"relative before:absolute before:-left-0.5 before:w-0.5 before:inset-y-2.5 before:rounded-l-md before:bg-transparent has-fx-active:before:bg-fg-title\">\n            <a href={href} data-state={isActive ? 'active' : null} aria-label={`Link to ${text}`}\n                className=\"flex items-center text-sm h-10 px-3 py-1.5 gap-x-2.5 fx-active:bg-background fx-active:text-foreground fx-current:bg-background fx-current:text-title border border-transparent fx-active:border-bg-muted/70 fx-active:shadow-xs rounded-lg\">\n                <span className={`flex iconify size-3.5 ${icon}`}></span>\n                {text}\n            </a>\n        </li>\n    )\n}\n",
      "type": "registry:block",
      "target": "components/sidebar-item.tsx"
    }
  ],
  "type": "registry:block"
}