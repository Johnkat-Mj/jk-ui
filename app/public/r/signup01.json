                   Create Account\n                    </Button>\n                </form>\n\n                <div className=\"text-center mt-6\">\n                    <p className=\"text-sm text-muted-foreground\">\n                        Already have an account?\n                        <Link href=\"#\" className=\"font-medium text-primary ml-1\">Login</Link>\n                    </p>\n                </div>\n            </Card>\n        </main>\n    )\n}\n",
